#include <Servo.h>

Servo myServo;
const int cardboardPin = 2;
const int servoPin = 9;

void setup() {
  pinMode(cardboardPin, INPUT);
  myServo.attach(servoPin);
  myServo.write(0);
}

void loop() {
  if (digitalRead(cardboardPin) == HIGH)
  {
    myServo.write(180);
  } 
  else 
  {
    myServo.write(0);
  }
  delay(15);
}
